generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  USER
  ADMIN
}

enum EstadoOrden {
  PENDIENTE
  PAGADO
  PREPARANDO
  EN_TRANSITO
  ENTREGADO
  CANCELADO
}


/// * Tanto el id de los productos, direcciones, pagos y envíos se obtienen de las APIs 
/// * correspondientes por lo que no es necesario crear modelos adicionales para ellos.
model Usuario {
  id              String           @id
  rol             RolUsuario       @default(USER)
  createdAt       DateTime         @default(now())
  carrito         Carrito[]
  direcciones     Direccion[]
  favoritos       Favorito[]
  compras         OrdenCompra[]
  resenasProducto ResenaProducto[]
  resenasVendedor ResenaVendedor[]
}

model Favorito {
  id         String  @id @default(cuid())
  usuarioId  String
  productoId String
  usuario    Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, productoId])
}

model Carrito {
  id         String  @id @default(cuid())
  usuarioId  String
  productoId String
  cantidad   Int
  usuario    Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, productoId])
}

/// * Dejamos libre la direccion y telefono para que
/// * varios usuarios puedan compartir la misma dirección o teléfono si lo desean.
model Direccion {
  id String   @id @default(cuid())
  usuarioId String
  provincia String
  codigoPostal String
  localidad String
  calle String
  altura String
  pisoDepto String?
  telefono String
  nombreDestinatario String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
}

model OrdenCompra {
  id              String            @id @default(cuid())
  usuarioId       String
  vendedorId      String           
  pagoId          String?           @unique
  envioId         String?           @unique
  estado          EstadoOrden
  total           Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  items           ItemOrdenCompra[]
  direccionId     String            
  // Datos del envio que usa shipping app. 
  costoEnvio      Int              
  operadorEnvio   String           
  servicioEnvio   String
  demoraDias      Int
  usuario         Usuario           @relation(fields: [usuarioId], references: [id])
  resenasProducto ResenaProducto[]
  resenasVendedor ResenaVendedor[]

  @@index([usuarioId, createdAt])
  @@index([estado, createdAt])
}

model ItemOrdenCompra {
  id            String      @id @default(cuid())
  ordenCompraId String
  productoId    String
  nombre        String?
  marca         String?
  imagenUrl     String?
  vendedor      String?
  precio        Int
  cantidad      Int
  ordenCompra   OrdenCompra @relation(fields: [ordenCompraId], references: [id])

  @@index([ordenCompraId])
}
/*
* Feedback app es dueña de la información de las reseñas pero
* desde el punto de vista de cache y de la generación de resúmenes, 
* es más eficiente tener un modelo que guarde el resumen de cada producto y la cantidad de reseñas procesadas
* en lugar de tener que consultar la API de feedback app cada vez que se necesite un resumen.
*/
model ResumenProductoIA {
  id                String   @id @default(cuid())
  productoId        String   @unique 
  resumenProducto   String?  @db.Text
  resumenVendedor   String?  @db.Text
  resenasProcesadas Int      @default(0)
  actualizadoEn     DateTime @updatedAt
}

model ResenaProducto {
  id            String      @id @default(cuid())
  usuarioId     String
  ordenCompraId String
  productoId    String
  puntuacion    Int
  comentario    String?     @db.Text
  createdAt     DateTime    @default(now())

  usuario       Usuario     @relation(fields: [usuarioId], references: [id])
  ordenCompra   OrdenCompra @relation(fields: [ordenCompraId], references: [id])

  @@unique([usuarioId, ordenCompraId, productoId])
  @@index([productoId])
  @@index([usuarioId])
}

model ResenaVendedor {
  id            String      @id @default(cuid())
  usuarioId     String
  ordenCompraId String
  vendedorId    String
  puntuacion    Int
  comentario    String?     @db.Text
  createdAt     DateTime    @default(now())

  usuario       Usuario     @relation(fields: [usuarioId], references: [id])
  ordenCompra   OrdenCompra @relation(fields: [ordenCompraId], references: [id])

  @@unique([usuarioId, ordenCompraId, vendedorId])
  @@index([vendedorId])
  @@index([usuarioId])
}
